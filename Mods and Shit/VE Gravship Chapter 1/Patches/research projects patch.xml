<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Rename and repurpose the existing early gravtech projects. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="BasicGravtech"]/label</xpath>
    <value><label>gravjumper</label></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="BasicGravtech"]/researchViewY</xpath>
    <value><researchViewY>6</researchViewY></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="StandardGravtech"]/label</xpath>
    <value><label>gravship</label></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="StandardGravtech"]/researchViewY</xpath>
    <value><researchViewY>6</researchViewY></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_OxygenNetwork"]/label</xpath>
    <value><label>oxygen logistics</label></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_OxygenNetwork"]/researchViewY</xpath>
    <value><researchViewY>8</researchViewY></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_GravshipLiving"]/researchViewY</xpath>
    <value><researchViewY>9</researchViewY></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_GravshipPower"]/label</xpath>
    <value><label>astrofuel generator</label></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_GravshipPower"]/description</xpath>
    <value><description>Construct a generator that consumes astrofuel to supply power aboard a gravship.</description></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_GravshipPower"]/baseCost</xpath>
    <value><baseCost>20</baseCost></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VGE_GravshipPower"]/researchViewY</xpath>
    <value><researchViewY>2</researchViewY></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="OrbitalTech"]/label</xpath>
    <value><label>vac barriers</label></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="OrbitalTech"]/description</xpath>
    <value><description>Construct powered barriers and barrier roofing that prevent depressurization while allowing free passage.</description></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="OrbitalTech"]/baseCost</xpath>
    <value><baseCost>20</baseCost></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="OrbitalTech"]/researchViewY</xpath>
    <value><researchViewY>6</researchViewY></value>
  </Operation>

  <!-- Split Chapter 1 and Odyssey unlocks into focused gravtech projects. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GravFieldExtender"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_GravFieldExtender</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_SmallHeatsink"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_SmallHeatsink</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GravcorePowerCell"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_GravcorePowerCell</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_GravshipCapacitor"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_GravshipCapacitor</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_SolarPanelling"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_OrbitalSolarPanelling</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="OrbitalScanner"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_OrbitalScanner</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_LifeSupportSystem"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_Oxyalgae</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_OxyalgaePlant"]/plant/sowResearchPrerequisites</xpath>
    <value><sowResearchPrerequisites Inherit="False"><li>Ferny_Oxyalgae</li></sowResearchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_EngineeringConsole"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_EngineeringConsole</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VGE_GravtechConsole"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_GravtechConsole</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Vanilla Gravship Expanded - Chapter 2</li></mods>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="VGE_EscapePod"]/researchPrerequisites</xpath>
      <value><researchPrerequisites Inherit="False"><li>Ferny_EscapePod</li></researchPrerequisites></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GravAnchor"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_GravAnchor</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TerrainDef[defName="VGE_GravshipSubscaffold"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_Subscaffold</li></researchPrerequisites></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="FuelOptimizer"]/researchPrerequisites</xpath>
    <value><researchPrerequisites Inherit="False"><li>Ferny_AstrofuelOptimizer</li></researchPrerequisites></value>
  </Operation>

  <!-- [sbz] Gravship Storage -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>[sbz] Gravship Storage</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="sbzGravshipShelfBase" or @Name="sbzSmallGravshipShelfBase"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_GravshipShelf</li></researchPrerequisites></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="sbz_GravshipWeaponRack"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_GravshipShelf</li></researchPrerequisites></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="sbzGravshipCrateBase"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_GravshipCrates</li></researchPrerequisites></value>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Vehicle Map Framework -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Vehicle Map Framework</li></mods>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="VMF_GravshipWheelSmall" or defName="VMF_GravshipWheelLarge"]/researchPrerequisites</xpath>
      <value><researchPrerequisites Inherit="False"><li>Ferny_GravshipWheels</li></researchPrerequisites></value>
    </match>
  </Operation>

  <!-- Dubs Bad Hygiene -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Dubs Bad Hygiene</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="SewageDumpPort"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_SewageDumpPort</li></researchPrerequisites></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="ToiletSpacer"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_VacuumToilet</li></researchPrerequisites></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="CryogenicExtractionNode"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_CryogenicExtractionNode</li></researchPrerequisites></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="SpacerWaterRecoverySystem"]/researchPrerequisites</xpath>
          <value><researchPrerequisites Inherit="False"><li>Ferny_WaterRecoverySystem</li></researchPrerequisites></value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
